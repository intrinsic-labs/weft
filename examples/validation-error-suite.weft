// Intentional error suite for Weft analyzer + LSP smoke testing.
// Expected: many diagnostics across duplicate symbols, unknown refs,
// type errors, and architecture/lifecycle violations.

@Rule("base-rule", '''
Known rule used as a control.
''')

@Definition("known-definition", '''
Known definition used as a control.
''')

@Decision("known-decision", '''
Known decision used as a control.
''')

@OpenQuestion("known-question", '''
Known open question used as a control.
''')

@Rule("dup-rule", '''
First declaration.
''')

@Rule("dup-rule", '''
Second declaration should trigger duplicate-symbol.
''')

@Role(adapter)
@Lifecycle(feature)
type OuterAdapter {
    id: string
}

@Role(entity)
type CoreEntity {
    """
    Unknown prose references:
    @Rule("missing-rule-ref")
    @Definition("missing-definition-ref")
    @Decision("missing-decision-ref")
    @OpenQuestion("missing-question-ref")
    `MissingType`
    `OuterAdapter.missingField`
    `GhostType.someField`
    """
    badDep: OuterAdapter
    unknownTypeField: MissingType
}

@Role(dto)
@Lifecycle(feature)
type ViewScopedDependency {
    id: string
}

@Role(usecase)
@Lifecycle(singleton)
@Implements("missing-rule-annotation")
@See("totally-missing-target")
type SingletonUseCase {
    dep: ViewScopedDependency
}

@Role(badrole)
@Lifecycle(global)
type InvalidAnnotations {
    id: string
}

@Role(adapter)
service BillingService {
    func checkout(input: MissingCheckoutInput) -> MissingCheckoutOutput throws
}
