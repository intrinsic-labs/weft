@Role(viewmodel)
@Lifecycle(view)
@Boundary(ui)
@Priority(p2)
type ThreadPreview {
    """
    UI projection of thread state for list rendering.
    """
    thread: Thread
    lastMessage: Message?
    unreadCount: int = 0
}

@Role(viewmodel)
@Lifecycle(view)
@Boundary(ui, "inbox")
@Priority(medium)
@TODO("Add optimistic unread counter updates while send is pending", owner: "ux", status: open, priority: p2)
view InboxScreen {
    """
    Main inbox surface.
    Backed by `Threading` and moderation-aware message visibility.
    """
    currentUser: User
    threads: [ThreadPreview]
    query: string = ""
    isLoading: bool = false

    func onAppear()
    func onSearchChanged(nextQuery: string)
    func onOpenThread(threadId: string)
}
