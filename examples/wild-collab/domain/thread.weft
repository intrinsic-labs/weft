@Role(entity)
@Schema
@Boundary(database, "core-storage")
@Priority(p2)
@TODO("Add workspace scoping key for future multi-workspace support", owner: "data", status: open, priority: p2)
type Thread {
    """
    Conversation stream between participants.
    """
    @Id(generated)
    id: string
    participantIds: [string]
    title: string?
    lastMessageAt: datetime?
    archivedAt: datetime?
}

enum MessageState {
    queued
    sent
    delivered
    read
    failed(reason: string)
}

@Role(entity)
@Schema
@Boundary(database, "core-storage")
@Priority(p1)
@TODO("Add retention partitioning for high-volume message tables", owner: "platform", due: "2026-04-15", status: in_progress, priority: p1)
type Message {
    """
    Message record tied to one thread and one sender.
    Enforced by @Rule("moderation-required").
    """
    @Id(generated)
    id: string
    threadId: string
    senderId: string
    body: string
    state: MessageState
    sentAt: datetime
    editedAt: datetime?
    deletedAt: datetime?
}
