{
  "name": "weft-vscode",
  "displayName": "Weft",
  "description": "Language support for Weft specification files",
  "version": "0.1.0",
  "publisher": "intrinsic-labs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:weft"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "weft",
        "aliases": ["Weft", "weft"],
        "extensions": [".weft"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "weft",
        "scopeName": "source.weft",
        "path": "./syntaxes/weft.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "tsup src/extension.ts --format cjs --external vscode",
    "dev": "tsup src/extension.ts --format cjs --external vscode --watch",
    "package": "vsce package"
  },
  "dependencies": {
    "@weft/lsp": "*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
