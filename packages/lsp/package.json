{
  "name": "@weft/lsp",
  "version": "0.1.0",
  "description": "Language Server Protocol implementation for Weft",
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./dist/parser.js": "./dist/parser.js",
    "./dist/analyzer.js": "./dist/analyzer.js",
    "./dist/ast.js": "./dist/ast.js"
  },
  "bin": {
    "weft": "./dist/cli.js",
    "weft-lsp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsup src/server.ts src/cli.ts src/parser.ts src/analyzer.ts src/ast.ts --format esm --dts",
    "dev": "tsup src/server.ts src/cli.ts --format esm --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
